#!/usr/bin/python3
# Get all repos of a GitHub org or user
# Author: Hanno Böck, https://hboeck.de/
# SPDX-License-Identifier: 0BSD

import argparse
import json
import pathlib
import urllib.request

ap = argparse.ArgumentParser()
ap.add_argument("org", help="Github organization name")
ap.add_argument("--print", action="store_true", help="print URLs instead of writing to files")
ap.add_argument("-r", "--resume")
args = ap.parse_args()

org = args.org


furl = f"https://api.github.com/users/{org}/repos?per_page=100&page="

forks = []
origs = []

p = 1
if args.resume:
    p = int(args.resume)

incomplete = False
while True:
    try:
        with urllib.request.urlopen(f"{furl}{p}") as con:
            j = json.load(con)
    except urllib.error.HTTPError:
        incomplete = True
        print(f"HTTP error at page {p}, incomplete")
        break
    if not j:
        break
    for x in j:
        if args.print:
            print(x["html_url"])
        elif x["fork"]:
            forks.append(x["html_url"])
        else:
            origs.append(x["html_url"])
    p += 1

ofn = org
if incomplete:
    ofn = f"{org}-incomplete-{p}"

if forks:
    pathlib.Path(f"{ofn}-forks.txt").write_text("\n".join(sorted(forks)) + "\n")
if origs:
    pathlib.Path(f"{ofn}-origs.txt").write_text("\n".join(sorted(origs)) + "\n")
